datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  VENDOR
  MANAGER
}

enum VendorStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum RFQStatus {
  DRAFT
  OPEN
  IN_REVIEW
  CLOSED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  SELECTED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum POStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  CLOSED
}

enum InvoiceStatus {
  PENDING_PAYMENT
  PAID
  OVERDUE
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  role               Role            @default(PROCUREMENT_OFFICER)
  country            String?
  additionalInfo     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  // Relations
  vendorProfile      Vendor?         // A user of role VENDOR links to their profile
  rfqsCreated        RFQ[]           @relation("RFQCreatedBy")
  approvalChainLogs  ApprovalChain[]
  purchaseOrders     PurchaseOrder[] @relation("POCreatedBy")
  activityLogs       ActivityLog[]
  notifications      Notification[]
}

model Vendor {
  id             String         @id @default(uuid())
  name           String
  category       String         // e.g., Furniture, IT, Logistics
  gstNo          String         @unique
  contactNo      String
  status         VendorStatus   @default(PENDING)
  rating         Float          @default(0.0)
  address        String?
  userId         String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  rfqAssignments RFQAssignment[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
}

model RFQ {
  id              String          @id @default(uuid())
  title           String
  category        String
  deadline        DateTime
  description     String?
  status          RFQStatus       @default(DRAFT)
  attachments     String[]
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  createdBy      User            @relation("RFQCreatedBy", fields: [createdByUserId], references: [id])
  lineItems      RFQLineItem[]
  assignments    RFQAssignment[]
  quotations     Quotation[]
  approvals      Approval[]
  purchaseOrders PurchaseOrder[]
}

model RFQLineItem {
  id        String   @id @default(uuid())
  rfqId     String
  item      String
  qty       Int
  unit      String   // e.g., NOS, KG, LTRS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}

model RFQAssignment {
  id        String   @id @default(uuid())
  rfqId     String
  vendorId  String
  createdAt DateTime @default(now())

  // Relations
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
}

model Quotation {
  id             String              @id @default(uuid())
  rfqId          String
  vendorId       String
  subtotal       Decimal             @db.Decimal(12, 2)
  gstPercentage  Decimal             @default(18.0) @db.Decimal(5, 2)
  gstAmount      Decimal             @db.Decimal(12, 2)
  grandTotal     Decimal             @db.Decimal(12, 2)
  deliveryDays   Int
  paymentTerms   String?             // e.g., "20 days net"
  status         QuotationStatus     @default(DRAFT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  rfq            RFQ                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lineItems      QuotationLineItem[]
  approvals      Approval[]
  purchaseOrders PurchaseOrder[]
}

model QuotationLineItem {
  id          String    @id @default(uuid())
  quotationId String
  item        String
  qty         Int
  unit        String
  unitPrice   Decimal   @db.Decimal(12, 2)
  totalVal    Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Approval {
  id             String          @id @default(uuid())
  rfqId          String
  quotationId    String
  currentStep    String          // e.g., "L1_Review", "L2_Approval", "PO_Generation"
  status         ApprovalStatus  @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  rfq            RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  chain          ApprovalChain[]
}

model ApprovalChain {
  id         String         @id @default(uuid())
  approvalId String
  userId     String
  role       Role
  status     ApprovalStatus @default(PENDING)
  actionDate DateTime?
  remarks    String?
  stepNumber Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relations
  approval   Approval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])
}

model PurchaseOrder {
  id              String        @id @default(uuid())
  poNumber        String        @unique // PO-YYYY-XXXX
  rfqId           String
  quotationId     String
  vendorId        String
  poDate          DateTime      @default(now())
  status          POStatus      @default(DRAFT)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  rfq             RFQ           @relation(fields: [rfqId], references: [id])
  quotation       Quotation     @relation(fields: [quotationId], references: [id])
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  createdBy       User          @relation("POCreatedBy", fields: [createdByUserId], references: [id])
  invoices        Invoice[]
}

model Invoice {
  id              String            @id @default(uuid())
  invoiceNumber   String            @unique
  purchaseOrderId String
  invoiceDate     DateTime          @default(now())
  dueDate         DateTime
  subtotal        Decimal           @db.Decimal(12, 2)
  cgst            Decimal           @db.Decimal(12, 2)
  sgst            Decimal           @db.Decimal(12, 2)
  grandTotal      Decimal           @db.Decimal(12, 2)
  status          InvoiceStatus     @default(PENDING_PAYMENT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineItems       InvoiceLineItem[]
}

model InvoiceLineItem {
  id        String   @id @default(uuid())
  invoiceId String
  item      String
  qty       Int
  unit      String
  unitPrice Decimal  @db.Decimal(12, 2)
  totalVal  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  type        String   // RFQ, APPROVAL, INVOICE, VENDOR, SYSTEM
  description String
  userId      String?
  metadata    Json?    // Context-specific JSON data
  createdAt   DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // Recipient of the alert
  type        String   // RFQ, APPROVAL, INVOICE, VENDOR, SYSTEM
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}